# 비밀값·로컬 설정 (커밋 금지)
.env
.env.*
*.key
*.pem
*token*
*secret*
# 이 PC 의 도구 경로 등 로컬 설정
config.local.json
# 로컬 채널 대주제(기본값은 커밋된 config/channel.json)
config/channel.local.json
# 로컬 제작 설정과 기존 도구 경로(커밋 금지)
config/settings.local.json
config/runtime.local.json
# 구형 개인 보관 설정도 공개하지 않음
config/storage.local.json
# 이 PC 에서만 쓰는 정리용 스크립트
scripts_local/

# 받아쓰기·로컬 목소리 모델 파일(scripts/setup_models.py 로 받음, 163MB·129MB)
models/

# 원자료·다른 사람의 영상/프레임/대본 (로컬 전용)
data/raw/
data/raw*
data/local_only/
*.mp4
*.webm
*.mkv
*.m4a
*.wav
*.mp3
*.part
*.ytdl

# 임시 파일
tmp/
*.tmp
*.log
__pycache__/
*.pyc
.venv/
.ipynb_checkpoints/
.DS_Store
Thumbs.db

# 프로그램 작업 폴더(수집 결과·캡처·렌더 결과 — 다른 사람의 글/이미지가 들어 있음)
work/
.pytest_cache/

# 테스트용으로 직접 만든 합성 소리(사인파·무음)는 커밋
!tests/fixtures/**/*.wav

# Qwen3-TTS 모델 캐시 (약 4.3GB)
tools/qwen_tts/models/

# 짤(밈) 이미지·내려받은 효과음 — 다른 사람이 만든 것이라 로컬 전용
assets_local/

# 직접 합성한 효과음(scripts/make_sfx.py)과 기본 효과음 꾸러미(assets/sfx_packs, README 에 출처·조건)는 커밋
!assets/sfx/**/*.wav
!assets/sfx_packs/**/*.wav

# 작업 로그
_logs/
